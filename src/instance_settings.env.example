# Log level: INFO, WARNING lub ERROR
LOG_LEVEL="INFO"

# Log to file
LOG_FILE_ENABLED=false

# Max log file size
LOG_FILE_MAX_BYTES=65536

#instance name
INSTANCE_NAME="garden"

#server address
REMOTE_DOMAIN=https://twoj-serwer.pl


# Valve names mapped to GPIO numbers
VALVES={"ZONE_A":18,"ZONE_B":19,"ZONE_C":20,"ZONE_D":21}

#default watering time in seconds
DEFAULT_WATERING_SECONDS=300
#DEFAULT_WATERING_SECONDS={"ZONE_A":100,"ZONE_B":100,"ZONE_C":300,"ZONE_D":200}


